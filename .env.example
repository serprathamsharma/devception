# ─────────────────────────────────────────────────────────────────────────────
# Devception — Unified Environment Configuration
# Copy this file to .env or use the respective client/server .env files.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend Configuration (devception-server) ──
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/devception
REDIS_URL=redis://localhost:6379
JWT_SECRET=devception_super_secret_jwt_key_local_dev
NEXTAUTH_SECRET=devception_super_secret_nextauth_local_dev
CLIENT_ORIGIN=http://localhost:3000
PLATFORM=local

# ── Impostor & Game Settings ──
GAME_DURATION_MS=900000
MEETING_DISCUSSION_MS=60000
MEETING_VOTING_MS=30000
MIN_PLAYERS=4
MAX_PLAYERS=8
IMPOSTER_BUG_COOLDOWN_MS=45000
IMPOSTER_BLUR_COOLDOWN_MS=60000
IMPOSTER_HINT_COOLDOWN_MS=30000

# ── Frontend Configuration (devception-client) ──
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXTAUTH_URL=http://localhost:3000
